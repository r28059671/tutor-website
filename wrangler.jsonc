{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "tutor-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tutor-db",
			// Replace with your own id from `npx wrangler d1 create tutor-db` (see README "Forking").
			"database_id": "dc5cf1b7-d118-4e82-9dd8-549bc044f19f",
			"migrations_dir": "drizzle"
		}
	],
	// Backblaze B2 holds PDFs, the tutor photo and D1 backups. See README "Forking".
	// B2_KEY_ID and B2_APP_KEY are secrets. Local dev overrides B2_BUCKET in .dev.vars.
	"vars": {
		// Copy the host from the bucket page in the Backblaze console, without https://.
		"B2_ENDPOINT": "s3.eu-central-003.backblazeb2.com",
		"B2_REGION": "eu-central-003",
		"B2_BUCKET": "patil-classes-pdfs"
	}
}